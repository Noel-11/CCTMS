<%@ Master Language="VB" AutoEventWireup="false" CodeFile="Applicant.master.vb" Inherits="MasterPage_Applicant" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml" lang="en">

<head runat="server">

    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link rel="Shortcut Icon" href="~/Images/favicon.ico" type="image/x-icon" />
    <title>CCTMS</title>

    <meta content="" name="description" />
    <meta content="" name="keywords" />
    <%--  --%>
    <asp:ContentPlaceHolder ID="cpHead" runat="server">

        <link href="<%=ResolveClientUrl("~/Scripts/NiceAdmin/vendor/bootstrap/css/bootstrap.min.css")%>" rel="stylesheet" />
        <link href="<%=ResolveClientUrl("~/Scripts/mycss/Applicant.css")%>" rel="stylesheet" />

        <link href="<%=ResolveClientUrl("~/Scripts/mycss/AppHeader.css")%>" rel="stylesheet" />
        <link href="<%=ResolveClientUrl("~//Scripts/mycss/AppFooter.css")%>" rel="stylesheet" />

        <script src="<%=ResolveClientUrl("~/Scripts/NiceAdmin/vendor/bootstrap/js/bootstrap.bundle.min.js")%>"></script>
        <%--<script src="<%=ResolveClientUrl("~/Scripts/Bootstrap5/jquery.min.js")%>"></script>--%>
        <script src="<%=ResolveClientUrl("~/Scripts/block/blockui.js")%>"></script>

    </asp:ContentPlaceHolder>

    <style>
        .page-wrapper {
            min-height: 100vh; /* full viewport height */
            display: flex;
            flex-direction: column;
        }

        .app-content {
            flex: 1; /* pushes footer to bottom */
        }

        .layout {
            display: flex;
        }

        /* SIDEBAR */
        .sidebar {
            width: 220px;
            /*background-color: #2e7d32;*/
            padding: 15px;
            transition: transform 0.3s ease;
        }



        /* MAIN CONTENT */
        .main-view {
            flex: 1;
            padding: 20px;
        }

        /* HAMBURGER */
        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 22px;
            color: white;
            cursor: pointer;
        }

        /* MOBILE VIEW */
        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
            }

            .sidebar {
                position: fixed;
                top: 64px; /* height of header */
                left: 0;
                height: calc(100% - 64px);
                transform: translateX(-100%);
                z-index: 1000;
                background-color: #d8ebd8;
                border-radius: 8px;
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .layout {
                flex-direction: column;
            }
        }
    </style>

    <script>
        function toggleMenu() {
            document.getElementById("ctl00_divMenu").classList.toggle("show");
        }
    </script>

</head>

<body>

    <form id="form1" role="form" method="post" runat="server" autocomplete="off" defaultbutton="btnDoNothing">
        <asp:ScriptManager ID="ScriptManager1" runat="server">
            <Scripts>
                <asp:ScriptReference Path="~/Scripts/block/UPBlock.js" />
            </Scripts>
        </asp:ScriptManager>

        <asp:Button ID="btnDoNothing" runat="server" Enabled="false" Style="display: none;" />

        <div class="page-wrapper">

            <!-- HEADER -->
            <header class="app-header">
                <div class="header-left">
                    <button type="button" class="menu-toggle" onclick="toggleMenu()">☰</button>
                    <img src="images/citycollege-logo.png" alt="City College Logo" class="header-logo">
                    <div class="header-title">
                        <h1>City College Training Online Application</h1>
                        <span>City College of Cagayan de Oro City</span>
                    </div>
                </div>

                <div class="header-right">
                    <nav class="navbar navbar-expand-lg">
                        <div class="container-fluid">
                            <button class="navbar-toggler" type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#mainNavbar"
                                aria-controls="mainNavbar"
                                aria-expanded="false"
                                aria-label="Toggle navigation">
                                <span class="navbar-toggler-icon"></span>
                            </button>

                            <div class="collapse navbar-collapse" id="mainNavbar">
                                <ul class="navbar-nav ms-auto">
                                    <li class="nav-item">
                                        <a runat="server" class="nav-link text-light" id="aProfile" href="#">PROFILE</a>
                                    </li>
                                    <li class="nav-item">
                                        <a runat="server" class="nav-link text-light" id="aLogout" href="#">LOGOUT</a>
                                    </li>
                                    <%--  <li class="nav-item">
                            <a class="nav-link" href="#">REGISTER</a>
                        </li>--%>
                                </ul>
                            </div>
                        </div>
                    </nav>

                </div>
            </header>

            <!-- MAIN CONTENT -->
            <main class="app-content">
            <!-- sidebar + content here -->

            <%--<div class="container-fluid mt-3">--%>
          <%--  <div class="d-flex">--%>
                <div class="layout">
                <!-- LEFT SIDEBAR -->

          <%--  <aside class="sidebar" id="divSideMenu">
              <a class="menu-item active">Dashboard</a>
              <a class="menu-item">Completed Trainings</a>
              <a class="menu-item">Upcoming Trainings</a>
            </aside>--%>
              
                <div runat="server" id="divMenu" class="sidebar me-4" >
                    <asp:Button runat="server" Text="DASHBOARD" ID="btnDashboard"  />
                    <asp:Button runat="server" Text="COMPLETED TRAININGS" ID="btnComplete"  />
                    <asp:Button runat="server" Text="UPCOMING TRAININGS" ID="btnUpcoming"  />
                </div>
                  
                <!-- MAIN CONTENT -->
                <div class="main-view">
                     <asp:ContentPlaceHolder ID="cpConTent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>

                    </div>
            <%--</div>--%>
        <%--</div>--%>

        </main>
            <!-- FOOTER -->
            <footer class="app-footer">
                <div class="footer-content">

                    <div class="footer-logos">
                        <img src="images/citycollege-logo.png" alt="City College Logo">
                        <div class="footer-text">
                            <strong>City College Training Online Application</strong>
                            <span>Powered by: Information Technology Department</span>
                        </div>
                        <img src="images/it-department-logo.png" alt="IT Department Logo">
                    </div>

                    <div class="footer-actions">
                        <a href="https://www.citycollege.edu.ph" target="_blank" class="footer-btn">Visit Official Website
                        </a>
                        <a href="https://www.facebook.com/citycollege" target="_blank" class="footer-btn outline">Official Facebook Page
                        </a>
                    </div>

                    <div class="footer-copy">
                        © 2026 City College. All Rights Reserved.
                    </div>

                </div>
            </footer>


        </div>

        <div id="domMessage" style="display: none;">
            <div class="loader"></div>

        </div>

    </form>

</body>
</html>

